# CPES - Variáveis de ambiente
# Copie para .env e preencha os valores

# API Football (obrigatório para o robô)
API_FOOTBALL_KEY=

# WhatsApp - WAHA
WAHA_SESSION_NAME=cpes-alerts
WAHA_API_KEY=
WHATSAPP_GROUP_ID=
WHATSAPP_ADMIN=
WHATSAPP_UPDATES=

# Opcional
API_DAILY_LIMIT=100
LOG_LEVEL=INFO
DAILY_SUMMARY_TIME=23:00

# Analise de Cartoes (opcional - desativado por padrao)
ANALISE_CARTOES_ATIVA=false
WHATSAPP_GROUP_CARTOES=

# Email (Resend) — domínio verificado precisa bater com EMAIL_FROM
RESEND_API_KEY=
EMAIL_FROM=PressureIQ <no-reply@iqpressure.online>
APP_URL=https://membros.iqpressure.online

# ----------------------------------------------------------------
# DEV TEST MODE (para usar API Football no plano free de 100 reqs/dia)
# Quando true: cap de jogos/ciclo, polling 5min, status check 1h,
# limite diario forcado a 100. Prioriza jogos na janela 50-90.
# ----------------------------------------------------------------
DEV_TEST_MODE=false
DEV_TEST_MAX_GAMES=5
DEV_TEST_POLLING_INTERVAL=180
DEV_TEST_STATUS_CHECK_INTERVAL=1800
DEV_TEST_API_DAILY_LIMIT=1000
DEV_TEST_LOW_BUDGET_THRESHOLD=50
